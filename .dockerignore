# ─── Python / venv ───────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
.git/
.gitignore

# ─── Secrets — NEVER bake into an image (injected via env / Secret Manager) ───
.env
.env.*
!.env.cloud.example

# ─── Local data / runtime state — lives on the GCE data volume, not the image ─
*.db
*.db-shm
*.db-wal
nuroq.db*
agent_memory.db
*.log
shadow_trades.csv
portfolio.csv
*.csv
dpo_data/
scratch/
.gradio/
tests/

# ─── Big binaries the backend doesn't need ───────────────────────────────────
*.mp3
*.png
*.jpg
*.jpeg

# ─── Frontend — the SPA is built in a Docker stage and baked in (backend serves
#     it at /). Keep the source in context, but exclude heavy/build dirs. ───────
frontend/node_modules/
frontend/dist/
frontend/ios/
frontend/.last-built-api-base
