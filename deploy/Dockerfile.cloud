# NuroQ cloud image — React SPA + FastAPI backend + live agent + Cloudflare
# tunnel, for GCP (Linux/amd64).
#
#   • Stage 1 builds the React app (same-origin: VITE_API_BASE="").
#   • Stage 2 = Python backend; MLX is skipped (pyproject darwin marker), AI runs
#     via Gemini. The built SPA is baked in so the backend serves it at /.
#   • cloudflared provides an HTTPS tunnel (see deploy/entrypoint.sh) — reachable
#     from anywhere with no inbound firewall opening.
#   • TZ=America/New_York so is_market_hours() is correct.
#
# Built by Cloud Build via deploy/cloudbuild.yaml (multi-stage works there).

# ─── Stage 1: build the React SPA ────────────────────────────────────────────
FROM node:20-slim AS frontend
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci
COPY frontend/ ./
# Empty API base → the SPA calls /api/* on its own origin (the tunnel host),
# which is the same backend serving it. Auth flows via the nuroq_key cookie.
RUN VITE_API_BASE="" npm run build

# ─── Stage 2: Python backend + cloudflared ───────────────────────────────────
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN apt-get update && apt-get install -y --no-install-recommends \
        tzdata ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# cloudflared (Cloudflare Tunnel) static binary.
RUN curl -fsSL https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 \
        -o /usr/local/bin/cloudflared \
    && chmod +x /usr/local/bin/cloudflared

ENV TZ=America/New_York
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /app

# CPU-only PyTorch FIRST. The default torch wheel bundles the entire ~3GB NVIDIA
# CUDA stack (libcufft/cublas/nccl/…) which is useless on this CPU VM and bloated
# the image to ~5GB (filled the boot disk). Installing the CPU build up front
# means sentence-transformers reuses it instead of pulling CUDA → image ~1.5GB.
RUN uv pip install --system --index-url https://download.pytorch.org/whl/cpu torch

# Python deps (layer-cached). mlx-lm is skipped by its darwin marker; torch is
# already satisfied by the CPU build above, so no CUDA packages are pulled.
COPY pyproject.toml uv.lock ./
RUN uv pip install --system -r pyproject.toml

# App code, then overlay the built SPA so backend/api.py mounts it at /.
COPY . .
COPY --from=frontend /fe/dist ./frontend/dist

ENV NUROQ_AI_BACKEND=gemini \
    NUROQ_DB_PATH=/data/nuroq.db \
    NUROQ_BACKGROUND_SERVICES=1 \
    NUROQ_AUTOSTART_AGENT=1 \
    NUROQ_INPROC_SCHEDULER=1 \
    NUROQ_TUNNEL=1 \
    PORT=8000

EXPOSE 8000
RUN mkdir -p /data

COPY deploy/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
CMD ["/entrypoint.sh"]
