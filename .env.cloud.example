# NuroQ cloud (.env) — copy to .env and fill in. Consumed by deploy/deploy_gce.sh
# (synced to Secret Manager + injected into the VM container). NEVER commit .env.

# ── Market data ──────────────────────────────────────────────────────────────
POLYGON_API_KEY=

# ── Brokerage (paper until you flip NUROQ_LIVE_TRADING) ──────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Telegram bot (single poller — exactly one instance) ──────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI tiebreaker (cloud backend) ────────────────────────────────────────────
# AI Studio key. (Or set NUROQ_GEMINI_VERTEX=1 to use the VM's service account
# via Vertex AI and omit this — then no key to manage.)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash          # or gemini-2.5-flash-lite (cheaper)

# ── API auth (REQUIRED in cloud — gates every request) ───────────────────────
# Generate: openssl rand -hex 24
NUROQ_API_KEY=

# ── Runtime (the deploy script sets these as container env; shown for clarity) ─
# NUROQ_AI_BACKEND=gemini
# NUROQ_DB_PATH=/data/nuroq.db
# NUROQ_BACKGROUND_SERVICES=1
# NUROQ_AUTOSTART_AGENT=1
# NUROQ_LIVE_TRADING=0          # keep 0 (paper). To go live you ALSO need:
# NUROQ_WASH_SALE_AWARE=1       #   one of these two (wash-sale ack)…
# NUROQ_SECTION_475=0           #   …or assert a valid §475 election
# TZ=America/New_York
